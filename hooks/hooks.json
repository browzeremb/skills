{
  "description": "Browzer plugin hooks — every handler delegates to a thin shell wrapper that pipes hook JSON into `browzer hook <name>` (the Go CLI). Exit-code protocol: 0=allow (payload on stdout), 1=passthrough, 2=deny, 3=ask. Telemetry-only handlers are async to keep the agent loop off the critical path. The Go subcommand reads the full `tool_input.command` from stdin and applies its own internal filtering, so handler entries no longer carry `if` permission predicates — the per-subcommand collapse (rewrite-bash 13→1, sync-on-push 7→1, postuse-run 4→1, prd-frozen 2→1, track-wasted 4→1) lives inside each Go subcommand.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rewrite-bash.sh\""
          },
          {
            "type": "command",
            "timeout": 5,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/contract.sh\""
          },
          {
            "type": "command",
            "if": "Bash(browzer init*)",
            "timeout": 5,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/init.sh\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rewrite-read.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/block-glob.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/suggest-grep.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/prd-frozen.sh\""
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/validate-subagent-type.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 30,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/sync-on-push.sh\""
          },
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/track-cli.sh\""
          },
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/track-wasted.sh\""
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/postuse-run.sh\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/postuse-read.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/postuse-grep.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/postuse-glob.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/incremental-sync.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop.sh\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-summary.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
